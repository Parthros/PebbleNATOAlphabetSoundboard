{
    "author": "Brophy",
    "keywords": [
        "pebble-app"
    ],
    "name": "nato-alphabet",
    "scripts": {
        "compile": "node esbuild.config.js",
        "pebble-build": "pebble build",
        "pebble-install": "pebble install --emulator emery --logs",
        "build": "npm run compile && pebble wipe && npm run pebble-build && npm run pebble-install"
    },
    "pebble": {
        "displayName": "NATO Alphabet Soundboard",
        "enableMultiJS": true,
        "messageKeys": [
            "BackgroundColor",
            "ForegroundColor"
        ],
        "projectType": "moddable",
        "resources": {
            "media": []
        },
        "sdkVersion": "3",
        "targetPlatforms": [
            "emery",
            "gabbro"
        ],
        "capabilities": [
            "configurable"
        ],
        "uuid": "e8646082-1635-45a9-950f-2238ea78e861",
        "watchapp": {
            "watchface": false
        }
    },
    "version": "1.0.1",
    "devDependencies": {
        "@moddable/typings": "^8.1.1",
        "esbuild": "^0.28.0",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "@rebble/clay": "1.0.8"
    }
}
